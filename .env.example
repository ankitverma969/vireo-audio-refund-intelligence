# Vireo Audio Refund Intelligence Configuration
# Copy this file to .env for local environment overrides

DATA_DIR=data/raw
REPORTS_DIR=reports
LOG_LEVEL=INFO

# AI Classifier Configuration (default: local rule-based baseline)
CLASSIFIER_PROVIDER=local
# Optional external LLM configuration (leave blank for local mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
